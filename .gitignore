# Generated archives and build output
/dist/
/release-*/
*.zip
/SOURCE-MANIFEST.json

# Downloaded dependencies and local tools
node_modules/
/.pi/
.venv/
__pycache__/
*.pyc

# Disposable WordPress runtimes and generated test output
/scripts/test-runtime/fixtures/
/scripts/test-runtime/runs/
/scripts/test-runtime/oauth-http-disposable-*/
/scripts/test-runtime/admin-033-fixtures/
/scripts/test-runtime/ui-preview/
/scripts/test-runtime/design-browser-preview/
/scripts/test-runtime/brand-preview/
/scripts/test-runtime/*-output.json
/scripts/test-runtime/*-render.html
/scripts/test-runtime/brand-verification.json
/scripts/test-runtime/wp-tools.json
/scripts/test-runtime/*-result.json

# Local secrets and site configuration
.env
.env.*
!.env.example
wp-config.php
*.sqlite
*.sqlite3
*.db
*.sql

# Editor and OS metadata
.DS_Store
Thumbs.db
*.swp
*.swo

# Keep curated docs/evidence, lockfiles, and source fixtures under version control.
