{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": [
    "jalin-mcp-gateway/assets/**/*.js",
    "scripts/**/*.mjs",
    "scripts/**/*.cjs",
    "scripts/typecheck/**/*.d.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "scripts/test-runtime/fixtures/**",
    "scripts/test-runtime/runs/**",
    "scripts/test-runtime/ui-preview/**",
    "scripts/test-runtime/brand-preview/**",
    "scripts/test-runtime/design-browser-preview/**",
    "scripts/history/**",
    "docs/evidence/**"
  ]
}
